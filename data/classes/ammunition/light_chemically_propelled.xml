<ammunition-class>
	<identifier>light_chemically_propelled</identifier>
	<name>Light Chemically Propelled Ammunition</name>
	<description>This is a cartridge of 40 shells for light cannons with chemically propelled ammunition. The shell diameter is 4 cm, the length of the shell is 25 cm.</description>
	<base-price>120</base-price>
	<space-requirement>16</space-requirement>
	<visualization>
		<model-identifier>light_chemically_propelled_ammunition</model-identifier>
		<visualization-parts>
			<visualization-part>
				<part-identifier>ammunition</part-identifier>
				<style>
					<diffuse-color>
						<red>0.8</red>
						<green>0.3</green>
						<blue>0.3</blue>
						<opacity>1.0</opacity>
					</diffuse-color>
					<specular-color>
						<valid>true</valid>
						<value>
							<red>0.9</red>
							<green>0.8</green>
							<blue>0.8</blue>
							<opacity>1.0</opacity>
						</value>
					</specular-color>
					<shininess>
						<valid>true</valid>
						<value>80.0</value>
					</shininess>
					<program-identifier>default</program-identifier>
				</style>
			</visualization-part>
		</visualization-parts>
	</visualization>
	<cartridge-size>40</cartridge-size>
</ammunition-class>
